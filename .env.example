# Supabase (produção)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres direct (Prisma)
# Em produção: postgresql://...supabase.co:5432/postgres
# Em desenvolvimento local sem Supabase, usar SQLite: file:./dev.db
DATABASE_URL="file:./dev.db"
DIRECT_URL="file:./dev.db"

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=admin@condominio.app

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron (gerar 32+ chars random)
CRON_SECRET=replace-with-32-byte-random-secret-please

# Auth (dev): se DEV_AUTH_USER for definido, magic-link/Supabase é desactivado
# e a sessão é simulada com este email.
DEV_AUTH_USER=
